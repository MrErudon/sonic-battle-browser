{
  "name": "sonic-battle-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.22.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:browser:production": "node scripts/browser-production.mjs",
    "report:bundle": "node scripts/bundle-report.mjs",
    "balance": "node scripts/combat-balance.mjs",
    "balance:check": "node scripts/combat-balance.mjs --check",
    "balance:holdout": "node scripts/combat-balance.mjs --holdout",
    "assets:generate": "node scripts/generate-synthetic-atlas.mjs",
    "assets:check": "node scripts/generate-synthetic-atlas.mjs --check && node scripts/validate-character-assets.mjs",
    "build:fixtures": "PRESENTATION_FIXTURES=1 npm run build",
    "test:browser:presentation": "node scripts/browser-presentation.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "playwright": "^1.65.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
